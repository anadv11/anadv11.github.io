source 'https://rubygems.org'

gem 'jekyll'

# Only GitHub Pages supported plugins
group :jekyll_plugins do
    gem 'jekyll-feed'
    gem 'jekyll-sitemap'
    gem 'jemoji'
    gem 'jekyll-minifier'
    gem 'jekyll-paginate-v2'
    gem 'jekyll-scholar'
    gem 'jekyll-tabs'
end

# Development gems
group :development do
    gem 'github-pages'
end
